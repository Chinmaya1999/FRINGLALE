{
	# Let's Encrypt registration / expiry notices
	email pradipta@uuoinnovation.com
}

# Web: fringlale.com (HTTPS is automatic, HTTP redirects to HTTPS)
fringlale.com {
	encode zstd gzip
	request_body {
		max_size 12MB
	}
	reverse_proxy web:3000
}

www.fringlale.com {
	redir https://fringlale.com{uri} permanent
}

# API: api.fringlale.com
api.fringlale.com {
	encode zstd gzip
	request_body {
		max_size 12MB
	}
	reverse_proxy server:4000
}
