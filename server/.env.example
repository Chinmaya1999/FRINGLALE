NODE_ENV=development
PORT=4000
# Production: CLIENT_URL=https://fringlale.com (comma-separate extra origins)
CLIENT_URL=http://localhost:3000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/fringlale?appName=<app>
JWT_SECRET=change-me-long-random
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=
# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Storage (Cloudinary or S3)
CLOUDINARY_URL=
# Notifications
SMTP_URL=
SMS_PROVIDER_KEY=
WHATSAPP_TOKEN=
# Gold rate: fetched daily from free spot feeds (gold-api.com + open.er-api.com) when GOLD_API_URL is empty.
# GOLD_PREMIUM_PCT adds import duty / local premium on the international price (e.g. 6 for ~6%).
GOLD_PREMIUM_PCT=0
# Optional own feed returning { gold24PerGram, platinumPerGram, silverPerGram }; manual admin override always works
GOLD_API_URL=
GOLD_API_KEY=
# Price lock window in minutes
PRICE_LOCK_MINUTES=15
